# ==============================================================================
# CONFIGURAÇÃO DO SUPABASE - DESAFIO GF
# ==============================================================================
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto.
# Obtenha em: Supabase Dashboard > Project Settings > API

# URL do projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (anon public key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# AVISO DE SEGURANÇA CRÍTICO:
# NUNCA insira a chave "service_role" (secret) neste arquivo nem em qualquer parte
# do código frontend/APK. A chave anon é a única chave pública permitida no cliente.
